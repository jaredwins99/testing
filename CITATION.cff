repository-code: "https://github.com/jaredwins99/alt-protein-sales-effects"
url: "https://jaredwins99.github.io/alt-protein-sales-effects/"
license: MIT
keywords:
  - plant-based
  - alternative proteins
  - Bayesian multilevel models
  - Stan
  - reproducible research
